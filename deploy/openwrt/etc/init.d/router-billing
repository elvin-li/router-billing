#!/bin/sh /etc/rc.common
# procd-managed service for router-billing.
# Logs go to logread; stop via `/etc/init.d/router-billing stop`.

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/router-billing
CONF=/etc/router-billing/config.yaml

start_service() {
    [ -x "$PROG" ] || { echo "missing $PROG" >&2; exit 1; }
    [ -f "$CONF" ] || { echo "missing $CONF" >&2; exit 1; }

    # Ensure firewall rules are in place before the daemon starts.
    # Non-fatal (the admin UI is still useful without them) but LOUD —
    # pre-v0.104 the bare `|| true` swallowed a hard nft parse error and
    # every Paid_WiFi device was silently online for free.
    if [ -x /usr/share/router-billing/firewall-billing.sh ]; then
        /usr/share/router-billing/firewall-billing.sh apply || \
            logger -t router-billing -p daemon.err \
                "firewall apply FAILED — portal redirect / billing rules are missing"
    fi

    procd_open_instance
    procd_set_param command "$PROG" --config "$CONF"
    procd_set_param respawn 5 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file "$CONF"
    procd_close_instance
}

stop_service() {
    # Don't tear down firewall on every restart — only on full uninstall.
    :
}

service_triggers() {
    procd_add_reload_trigger "router-billing"
}

reload_service() {
    stop
    start
}
